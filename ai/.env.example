# Copy to .env and adjust. .env is gitignored — never commit it.

# Path to the YOLO weights. Swap this to point at a newly trained model;
# no code changes are needed anywhere else.
MODEL_PATH=weights/best.pt

# Reported back to the backend on every /infer response so a report can be
# traced to the model that produced it. Bump this on every retrain.
MODEL_VERSION=roadsense-yolov8n-v1

# Detections below this confidence are discarded. Person A owns this value;
# the backend never re-filters.
CONF_THRESHOLD=0.5
